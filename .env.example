# AgentsMail Environment Variables
# Copy this file to .dev.vars for local development

# Required: Resend API key for sending emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Required: HMAC secret for webhook signatures and email receipts
HMAC_SECRET=your-random-secret-string

# Optional: Admin panel password (admin disabled by default, set ENABLE_ADMIN=true to enable)
ADMIN_PASSWORD=
ENABLE_ADMIN=false

# Set in wrangler.toml (not here):
# DOMAIN=agentsmail.org
