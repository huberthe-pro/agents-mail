name = "agent-mailbox"
main = "src/index.ts"
compatibility_date = "2024-01-01"
account_id = "your-cloudflare-account-id"

[[d1_databases]]
binding = "DB"
database_name = "agent-mailbox"
database_id = "your-d1-database-id"

[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "agentsmail-attachments"

[vars]
DOMAIN = "agentsmail.org"

[triggers]
crons = ["0 * * * *"]
